{
  "name": "taixu-vscode",
  "displayName": "Taixu Language",
  "description": "Taixu (.tx) language support — syntax, snippets, LSP client powered by `taixu lsp` and DAP debugging powered by `taixu dap` (same-engine, zero in-plugin language implementation).",
  "version": "0.0.5",
  "publisher": "taixu",
  "license": "SEE LICENSE IN LICENSE-APACHE",
  "repository": {
    "type": "git",
    "url": "https://github.com/yockii/taixu-vscode"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "activationEvents": [
    "onDebugResolve:taixu"
  ],
  "main": "./src/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "受限模式下不采用工作区设置里的 taixu.path；语言服务只做只读分析，调试由 VS Code 在受限模式下禁用。",
      "restrictedConfigurations": [
        "taixu.path"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "taixu",
        "aliases": [
          "Taixu",
          "taixu"
        ],
        "extensions": [
          ".tx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "taixu",
        "scopeName": "source.taixu",
        "path": "./syntaxes/taixu.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "taixu",
        "path": "./snippets/taixu.json"
      }
    ],
    "configuration": {
      "title": "Taixu",
      "properties": {
        "taixu.path": {
          "type": "string",
          "scope": "window",
          "default": "",
          "description": "用于语言服务和原生调试的 taixu 可执行文件：绝对路径，或在 PATH 中查找的命令名（不在工作区目录里查找）。留空时依次取 TAIXU_PATH 环境变量、PATH 中的 taixu。修改后语言服务自动重启。"
        }
      }
    },
    "commands": [
      {
        "command": "taixu.checkServer",
        "title": "Taixu: Check Server",
        "category": "Taixu"
      }
    ],
    "debuggers": [
      {
        "type": "taixu",
        "label": "Taixu Debug",
        "languages": [
          "taixu"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "要调试的 .tx 源文件（建议 ${workspaceFolder}/app.tx 绝对形态）",
                "default": "${workspaceFolder}/main.tx"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "传给程序 main(args) 的参数",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "调试目标工作目录（程序相对路径读写以此为准）",
                "default": "${workspaceFolder}"
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "Taixu: 启动调试（launch .tx 程序）",
            "description": "调试当前工作区的 Taixu 程序（原生插桩：断点/步进/变量）",
            "body": {
              "type": "taixu",
              "request": "launch",
              "name": "调试 Taixu 程序",
              "program": "^\"\\${workspaceFolder}/main.tx\"",
              "cwd": "^\"\\${workspaceFolder}\""
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "test:editor": "node test/run.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
